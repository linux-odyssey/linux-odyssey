{
  "name": "linux-odyssey",
  "version": "0.0.0",
  "main": "index.js",
  "repository": "https://github.com/linux-odyssey/linux-odyssey",
  "license": "GPL",
  "private": true,
  "workspaces": [
    "app",
    "server",
    "packages/*",
    "services/*",
    "tests"
  ],
  "scripts": {
    "app": "bun run --filter app dev",
    "build": "bun run --filter app build",
    "dev": "concurrently -n \"App,Server\" -c \"bgBlue.bold,bgGreen.bold\" \"bun run --filter app dev\" \"bun run --filter server dev\"",
    "server": "bun run --filter server dev",
    "lint": "eslint .",
    "format": "prettier --ignore-path .prettierignore --write app server",
    "test": "bun test",
    "test:e2e": "bun run --filter tests test",
    "test:open": "bun run --filter tests test:open",
    "analytics": "bun run --filter analytics dev",
    "setup": "bun run --filter server setup",
    "clean": "bun run --filter server clean",
    "build:quests": "bun run --filter server build:quests",
    "type-check": "bun run --filter server --filter analytics --filter app type-check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.10.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vue/eslint-config-prettier": "^7.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-vue": "^9.15.1",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.3.3",
    "vue-eslint-parser": "^9.4.2"
  },
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@mapbox/node-pre-gyp/tar": "^7.5.19",
    "@cypress/request/form-data": "^2.5.4"
  }
}
